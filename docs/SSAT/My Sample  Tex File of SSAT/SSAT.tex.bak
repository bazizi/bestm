\begin{ex}

What is 5\% sale tax of a \$780 laptop?


$
\begin{array}{ccccc}
  (A)\hspace{0.2cm} \$741 \hspace{1cm} & (B)\hspace{0.2cm}
   \$39 \hspace{1cm} & (C)\hspace{0.2cm} \$819 \hspace{1cm} &
(D)\hspace{0.2cm} \$56 \hspace{1cm} &
   (E)\hspace{0.2cm} \$25 \\
\end{array}
$

\end{ex}

\s $\frac{5}{100}\times 780=\frac{5}{100}\times
\frac{780}{1}=\frac{5\times 780}{100\times 1}=39.$

\vspace{0.5cm} \shadowbox{\n
   {\it
The total cost of \$95 with 8\% tax is \hspace{0.5cm} $95\times
\frac{100+8}{100}.$
 }
 \hspace{2.5cm}}



\begin{ex}

What is the total cost of a \$750 TV with 6\% sale tax?

$
\begin{array}{ccccc}
  (A)\hspace{0.2cm} \$45 \hspace{1cm} & (B)\hspace{0.2cm}
   \$705 \hspace{1cm} & (C)\hspace{0.2cm} \$875 \hspace{1cm} &
(D)\hspace{0.2cm} \$795 \hspace{1cm} &
   (E)\hspace{0.2cm} \$740 \\
\end{array}
$
\end{ex}

\s $750\times \frac{100+6}{100}=\frac{750}{1}\times
\frac{106}{100} =\frac{750\times 106 }{100\times 1}=795.$


\vspace{0.5cm} \shadowbox{\n
   {\it
The sale price of \$65 with 7\% sale off is \hspace{0.5cm}
$65\times \frac{100-7}{100}.$
 }
 \hspace{1.5cm}}


\begin{ex}

A \$700 computer is on sale for 9\% off. What is the sale price?

$
\begin{array}{ccccc}
  (A)\hspace{0.2cm} \$637 \hspace{1cm} & (B)\hspace{0.2cm}
   \$691 \hspace{1cm} & (C)\hspace{0.2cm} \$610 \hspace{1cm} &
(D)\hspace{0.2cm} \$630 \hspace{1cm} &
   (E)\hspace{0.2cm} \$623 \\
\end{array}
$
\end{ex}


\s $700\times \frac{100-9}{100}=\frac{700}{1}\times \frac{91}{100}
=\frac{700\times 91}{100}=637.$


